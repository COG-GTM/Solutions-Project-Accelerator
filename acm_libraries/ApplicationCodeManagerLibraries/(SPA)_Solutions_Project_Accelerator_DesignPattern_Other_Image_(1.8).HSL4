      <SObjs />
    </Pars>
    <Funcs>
      <Func Name="WidthFinal" Scope="Object" CLXDep="true" AADDep="false" FType="Calculation" ResType="Bool">
        <Exp><![CDATA[{Abs({X1}-{X2})}]]></Exp>
      </Func>
      <Func Name="HeightFinal" Scope="Object" CLXDep="true" AADDep="false" FType="Calculation" ResType="Bool">
        <Exp><![CDATA[{Abs({Y1}-{Y2})}]]></Exp>
      </Func>
      <Func Name="TopFinal" Scope="Object" CLXDep="true" AADDep="false" FType="Conditional" ResType="Integer">
        <ifcond Value="{Y1}"><![CDATA[{Y1}<{Y2}]]></ifcond>
        <else Value="{Y2}" />
      </Func>
      <Func Name="LeftFinal" Scope="Object" CLXDep="true" AADDep="false" FType="Conditional" ResType="Integer">
        <ifcond Value="{X1}"><![CDATA[{X1}<{X2}]]></ifcond>
        <else Value="{X2}" />
      </Func>
    </Funcs>
