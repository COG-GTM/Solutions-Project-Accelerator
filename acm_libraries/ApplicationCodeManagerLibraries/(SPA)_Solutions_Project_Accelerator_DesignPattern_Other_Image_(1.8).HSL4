        <Par Name="X1" DVal="0" DType="Int" RType="Immediate" Group="" ParH="" ROnly="false" Min="0" Max="99999999999" CType="TextBox" AInc="false" AIncOffset="1" Pad="false" CLXDep="true" AADDep="false" />
        <Par Name="Y1" DVal="0" DType="Int" RType="Immediate" Group="" ParH="" ROnly="false" Min="0" Max="99999999999" CType="TextBox" AInc="false" AIncOffset="1" Pad="false" CLXDep="true" AADDep="false" />
        <Par Name="X2" DVal="0" DType="Int" RType="Immediate" Group="" ParH="" ROnly="false" Min="0" Max="99999999999" CType="TextBox" AInc="false" AIncOffset="1" Pad="false" CLXDep="true" AADDep="false" />
        <Par Name="Y2" DVal="0" DType="Int" RType="Immediate" Group="" ParH="" ROnly="false" Min="0" Max="99999999999" CType="TextBox" AInc="false" AIncOffset="1" Pad="false" CLXDep="true" AADDep="false" />
        <Par Name="ImageName" DVal="" DType="String" RType="Immediate" Group="" ParH="" ROnly="false" CType="TextBox" AInc="false" AIncOffset="1" Pad="false" CLXDep="true" AADDep="false" />
        <Par Name="SEAssocDisplay" DVal="" DType="String" RType="Reference" Group="HMI Configuration" Vis="True" Filter="Library.LibraryType='HMI' And Library.Category='Display'" ParH="Associated HMI SE Display" ROnly="false" CType="Reference" AInc="false" AIncOffset="1" Pad="false" CLXDep="false" AADDep="false" />
        <Par Name="MEAssocDisplay" DVal="" DType="String" RType="Reference" Group="HMI Configuration" Vis="True" Filter="Library.LibraryType='HMI' And Library.Category='Display'" ParH="Associated HMI ME Display" ROnly="false" CType="Reference" AInc="false" AIncOffset="1" Pad="false" CLXDep="false" AADDep="false" />
