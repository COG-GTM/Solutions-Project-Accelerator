# Solutions Project Accelerator — deployment configuration.
# Copy to `.env` (git-ignored) and fill in the values for your deployment.
# Real environment variables take precedence over entries in this file.
#
# Load order (first hit wins):
#   1. $SPA_ENV_FILE
#   2. ./.env  (process working directory)
#   3. <repo root>/.env, or the folder containing runme.exe in a frozen build
#   4. %USERPROFILE%/.spa/spa.env

# --- Help menu links (optional; the entry reports "not configured" if blank) --
SPA_DOCUMENTATION_URL=
SPA_GET_HELP_URL=
SPA_JOIN_TEAM_URL=

# --- Optional enterprise LLM gateway ----------------------------------------
# The gateway client lives in the separate `genai_bridge` repository and reads
# its own GENAI_* variables. They can be placed here too, or in genai_bridge's
# own .env. See genai_bridge/.env.example for the full list.
# GENAI_BASE_URL=
# GENAI_SUBSCRIPTION_KEY=
# GENAI_CLIENT_ID=
# GENAI_TENANT_ID=
# GENAI_CLIENT_SECRET=
# GENAI_API_SCOPE=
# GENAI_KEY_VAULT_URL=
